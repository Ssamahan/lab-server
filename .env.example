# Copy to .env and fill
PORT=3000
# Generate strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-32+chars-random-string
# Admin credentials for Lab Systems - same as your app login
ADMIN_USERNAME=admin
# Hash your password: node -e "console.log(require('bcryptjs').hashSync('YourPassword',10))"
ADMIN_PASSWORD_HASH=$2a$10$examplehashreplacewithrealhash
# Or plain for first setup (will be hashed on first run if HASH not set)
ADMIN_PASSWORD=RuliLab@2026
# Allowed origin for CORS - your GitHub Pages
ALLOWED_ORIGIN=https://ssamahan.github.io
# Optional: second origin for local testing
ALLOWED_ORIGIN_2=http://localhost:5500
# Data file path (SQLite)
DB_PATH=./data/lab.db
